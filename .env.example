# Local development configuration only.
# Copy this file to .env and set both passwords before running Docker Compose.
# Empty values intentionally make Compose fail until credentials are configured.
# Never commit a real .env file or reuse local credentials in a public deployment.
MYSQL_USER=countercheck
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173