# Local development configuration only.
# Copy to .env and replace both password placeholders with unique local values.
# Never commit a real .env file or reuse these placeholders in a public deployment.
MYSQL_USER=countercheck
MYSQL_PASSWORD=replace-with-a-unique-local-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-unique-local-password
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
