# Local development configuration only.
# Copy to .env and set both password values before running Docker Compose.
# Empty values intentionally make Compose fail until you configure local credentials.
# Never commit a real .env file or reuse local credentials in a public deployment.
MYSQL_USER=countercheck
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
